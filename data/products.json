    "数组说明": {
      "oldRules": "旧款 SN 料号（ZF、LH 等开头），字段：prefix + model",
      "newRules": "新款 SN 料号（Z 开头，2025 年后），字段：prefix + model",
      "exceptions": "特例 SN（整条固定匹配），字段：sn + model + dateText"
